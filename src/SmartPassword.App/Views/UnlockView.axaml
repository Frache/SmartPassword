<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartPassword.App.ViewModels"
             x:Class="SmartPassword.App.Views.UnlockView"
             x:DataType="vm:UnlockViewModel">

    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="460" Padding="32"
            CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
        <StackPanel Spacing="14">
            <TextBlock Text="SmartPassword" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Heading}" FontSize="16" Opacity="0.8" />

            <StackPanel Spacing="4">
                <TextBlock Text="Vault-fil" FontSize="12" Opacity="0.7" />
                <TextBox Text="{Binding VaultPath}" IsReadOnly="True" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Åbn eksisterende…" Command="{Binding BrowseExistingCommand}" />
                    <Button Content="Ny vault…" Command="{Binding BrowseNewCommand}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Master-password" FontSize="12" Opacity="0.7" />
                <TextBox x:Name="PasswordBox" Text="{Binding Password}" PasswordChar="•" />
            </StackPanel>

            <StackPanel Spacing="4" IsVisible="{Binding IsCreateMode}">
                <TextBlock Text="Gentag master-password" FontSize="12" Opacity="0.7" />
                <TextBox Text="{Binding ConfirmPassword}" PasswordChar="•" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <ProgressBar Minimum="0" Maximum="4" Value="{Binding Strength}" Width="160" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StrengthText}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Husk dit master-password – det kan ikke gendannes." FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Text="{Binding Notice}" FontSize="12" Opacity="0.8" TextWrapping="Wrap"
                       IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <TextBlock Text="{Binding Error}" Foreground="#D13438" TextWrapping="Wrap"
                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Grid ColumnDefinitions="*,Auto">
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Grid.Column="1" Content="{Binding ActionText}" Command="{Binding SubmitCommand}"
                        IsDefault="True" IsEnabled="{Binding !IsBusy}" Classes="accent" MinWidth="110"
                        HorizontalContentAlignment="Center" />
            </Grid>

            <!-- Updates -->
            <Border DataContext="{Binding Update}" x:DataType="vm:UpdateViewModel"
                    BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="0,12,0,0">
                <StackPanel Spacing="8">
                    <StackPanel Spacing="8" IsVisible="{Binding IsAvailable}">
                        <TextBlock Text="{Binding AvailableText}" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Opdater nu" Command="{Binding InstallCommand}" Classes="accent" IsEnabled="{Binding !IsInstalling}" />
                            <Button Content="Se hvad der er nyt" Command="{Binding OpenReleasePageCommand}" />
                        </StackPanel>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" IsVisible="{Binding IsInstalling}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap"
                               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <CheckBox Content="Søg efter opdateringer ved start" FontSize="12"
                                  IsChecked="{Binding CheckAutomatically}" IsVisible="{Binding CanSelfUpdate}" />
                        <TextBlock Grid.Column="1" Text="{Binding CurrentVersionText}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
