<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartPassword.App.ViewModels"
             x:Class="SmartPassword.App.Views.VaultView"
             x:DataType="vm:VaultViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewEntryCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveEntryCommand}" />
        <KeyBinding Gesture="Ctrl+B" Command="{Binding CopyUsernameCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding CopyPasswordCommand}" />
    </UserControl.KeyBindings>

    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="＋ Ny post" Command="{Binding NewEntryCommand}" Classes="accent" ToolTip.Tip="Ctrl+N" />
                    <Button Content="Optag CSV…" Command="{Binding ImportCommand}" />
                    <Button Content="Udtræk CSV…" Command="{Binding ExportCommand}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" Margin="16,0" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Opacity="0.6" />
                    <Button Content="🔒 Lås" Command="{Binding LockCommand}" ToolTip.Tip="Ctrl+L" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="340,*">
            <!-- List -->
            <DockPanel Grid.Column="0" Margin="12">
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText}" PlaceholderText="Søg (Ctrl+F)" />
                    <Grid ColumnDefinitions="*,Auto">
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" HorizontalAlignment="Stretch" />
                        <ToggleButton Grid.Column="1" Content="★ Favoritter" IsChecked="{Binding FavoritesOnly}" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding CountText}" FontSize="12" Opacity="0.6" Margin="4,8,0,0" />
                <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:EntryListItem">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="★" IsVisible="{Binding IsFavorite}" Foreground="#E3A008" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Editor -->
            <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <Panel>
                    <TextBlock Text="Vælg en post, eller opret en ny." HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"
                               IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNull}}" />

                    <DockPanel DataContext="{Binding Editor}" x:DataType="vm:EntryEditorViewModel"
                               IsVisible="{Binding $parent[UserControl].((vm:VaultViewModel)DataContext).Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Border DockPanel.Dock="Bottom" Padding="20,10" BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Button Content="Slet" Command="{Binding $parent[UserControl].((vm:VaultViewModel)DataContext).DeleteEntryCommand}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                    <Button Content="Annuller" Command="{Binding $parent[UserControl].((vm:VaultViewModel)DataContext).CancelEditCommand}" />
                                    <Button Content="Gem" Classes="accent" ToolTip.Tip="Ctrl+S"
                                            Command="{Binding $parent[UserControl].((vm:VaultViewModel)DataContext).SaveEntryCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Padding="20,10,20,20">
                            <StackPanel MaxWidth="640" HorizontalAlignment="Stretch">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Text="{Binding Name}" FontSize="20" PlaceholderText="Navn" />
                                    <CheckBox Grid.Column="1" Content="★ Favorit" IsChecked="{Binding IsFavorite}" Margin="12,0,0,0" />
                                </Grid>

                                <TextBlock Classes="label" Text="Brugernavn" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Text="{Binding Username}" />
                                    <Button Grid.Column="1" Content="Kopier" Margin="8,0,0,0" ToolTip.Tip="Ctrl+B"
                                            Command="{Binding $parent[UserControl].((vm:VaultViewModel)DataContext).CopyUsernameCommand}" />
                                </Grid>

                                <TextBlock Classes="label" Text="Password" />
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox Text="{Binding Password}" PasswordChar="•" RevealPassword="{Binding ShowPassword}" FontFamily="Consolas,Menlo,monospace" />
                                    <ToggleButton Grid.Column="1" Content="👁" IsChecked="{Binding ShowPassword}" Margin="8,0,0,0" ToolTip.Tip="Vis/skjul" />
                                    <Button Grid.Column="2" Content="Kopier" Margin="8,0,0,0" ToolTip.Tip="Ctrl+Shift+C"
                                            Command="{Binding $parent[UserControl].((vm:VaultViewModel)DataContext).CopyPasswordCommand}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                    <Button Content="Generer" Command="{Binding $parent[UserControl].((vm:VaultViewModel)DataContext).GeneratePasswordCommand}" />
                                    <NumericUpDown Value="{Binding $parent[UserControl].((vm:VaultViewModel)DataContext).GeneratorLength}"
                                                   Minimum="8" Maximum="128" Increment="1" FormatString="0" Width="120" />
                                    <CheckBox Content="Specialtegn" IsChecked="{Binding $parent[UserControl].((vm:VaultViewModel)DataContext).GeneratorSymbols}" />
                                    <CheckBox Content="Undgå 0/O, 1/l" IsChecked="{Binding $parent[UserControl].((vm:VaultViewModel)DataContext).GeneratorAvoidAmbiguous}" />
                                </StackPanel>

                                <TextBlock Classes="label" Text="Website" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Text="{Binding Website}" />
                                    <Button Grid.Column="1" Content="Åbn" Margin="8,0,0,0"
                                            Command="{Binding $parent[UserControl].((vm:VaultViewModel)DataContext).OpenWebsiteCommand}" />
                                </Grid>

                                <TextBlock Classes="label" Text="2FA (OTP)" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Text="{Binding Otp}" PasswordChar="•" RevealPassword="{Binding ShowOtpSecret}" PlaceholderText="Hemmelighed eller otpauth://-link" />
                                    <ToggleButton Grid.Column="1" Content="👁" IsChecked="{Binding ShowOtpSecret}" Margin="8,0,0,0" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0" IsVisible="{Binding HasOtp}">
                                    <TextBlock Text="{Binding OtpCode}" FontSize="22" FontFamily="Consolas,Menlo,monospace" LetterSpacing="2" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding OtpSecondsLeft, StringFormat='{}{0} s'}" Opacity="0.6" VerticalAlignment="Center" />
                                    <Button Content="Kopier kode" Command="{Binding $parent[UserControl].((vm:VaultViewModel)DataContext).CopyOtpCommand}" />
                                </StackPanel>

                                <TextBlock Classes="label" Text="Kategori" />
                                <TextBox Text="{Binding Category}" />

                                <TextBlock Classes="label" Text="Tags (adskilt med komma)" />
                                <TextBox Text="{Binding Tags}" AcceptsReturn="True" TextWrapping="Wrap" />

                                <TextBlock Classes="label" Text="Noter" />
                                <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />

                                <TextBlock Classes="label" Text="Andre felter" />
                                <TextBox Text="{Binding OtherFields}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" />

                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,16,0,0" Opacity="0.6">
                                    <TextBlock Grid.Row="0" Text="Oprettet:" FontSize="12" Margin="0,0,12,2" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CreatedText}" FontSize="12" />
                                    <TextBlock Grid.Row="1" Text="Opdateret:" FontSize="12" Margin="0,0,12,2" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UpdatedText}" FontSize="12" />
                                    <TextBlock Grid.Row="2" Text="Id:" FontSize="12" Margin="0,0,12,0" />
                                    <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Id}" FontSize="12" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Panel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
